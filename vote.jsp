<%@ page import="com.creatorhub.bean.Vote" %><%@ page import="com.creatorhub.dao.VoteDAO" %><%@ page contentType="text/html;charset=UTF-8" %><%
Integer id=(Integer)session.getAttribute("student_id");if(id==null){response.sendRedirect("login.jsp");return;}String x=request.getParameter("collab_id");if(x==null){response.sendRedirect("collaborations.jsp");return;}int collab=Integer.parseInt(x);VoteDAO dao=new VoteDAO();boolean success=false,already=dao.hasVoted(collab,id);if(!already){Vote v=new Vote();v.setCollabId(collab);v.setVoterId(id);success=dao.addVote(v);}
%><!DOCTYPE html><html><head><title>Upvote · Creator Hub</title><link rel="stylesheet" href="style.css"></head><body><div class="container"><div class="form-card card center"><div style="font-size:50px"><%=already?"👍":"🎉"%></div><h1><%=already?"Already upvoted":"Upvote successful"%></h1><p class="muted"><%=already?"You already supported this collaboration.":success?"Your upvote has been recorded.":"Something went wrong while recording your upvote."%></p><a class="btn" href="collaborations.jsp">Back to collaborations</a></div></div></body></html>