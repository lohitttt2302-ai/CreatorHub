<%@ page import="com.creatorhub.bean.Collaboration" %><%@ page import="com.creatorhub.dao.CollaborationDAO" %><%@ page import="com.creatorhub.dao.RatingDAO" %><%@ page contentType="text/html;charset=UTF-8" %><%
Integer student=(Integer)session.getAttribute("student_id");if(student==null){response.sendRedirect("login.jsp");return;}int collab=Integer.parseInt(request.getParameter("collab_id"));int creator=Integer.parseInt(request.getParameter("creator_id"));Collaboration c=new CollaborationDAO().getById(collab);boolean allowed=new RatingDAO().canRate(student,creator,collab);
%><!DOCTYPE html><html><head><title>Rate creator · Creator Hub</title><link rel="stylesheet" href="style.css"></head><body>
<%@ include file="sidebar.jsp" %><div class="container"><div class="form-card card"><a class="brand" href="studentPortal.jsp">Creator Hub</a><h1>Rate your collaboration</h1><p class="muted"><%=c==null?"":c.getTitle()%></p><%if(!allowed){%><div class="notice dangerbox">You can rate a creator only after a completed collaboration where you were the selected student.</div><%}else{%><form action="submitRating.jsp" method="post"><input type="hidden" name="collab_id" value="<%=collab%>"><input type="hidden" name="creator_id" value="<%=creator%>"><label>Rating</label><select name="rating" required><option value="">Choose 1–5</option><option value="5">5 — Excellent</option><option value="4">4 — Great</option><option value="3">3 — Good</option><option value="2">2 — Needs improvement</option><option value="1">1 — Poor</option></select><label>Review</label><textarea name="review" rows="6" placeholder="How was the collaboration?"></textarea><button class="btn full" type="submit">Publish rating</button></form><%}%></div></div></body></html>