<%@ page import="com.creatorhub.bean.Student" %><%@ page import="com.creatorhub.bean.StudentWork" %><%@ page import="com.creatorhub.bean.Collaboration" %><%@ page import="com.creatorhub.bean.Rating" %><%@ page import="com.creatorhub.dao.StudentDAO" %><%@ page import="com.creatorhub.dao.WorkDAO" %><%@ page import="com.creatorhub.dao.CollaborationDAO" %><%@ page import="com.creatorhub.dao.LikeDAO" %><%@ page import="com.creatorhub.dao.RatingDAO" %><%@ page import="java.util.List" %><%@ page contentType="text/html;charset=UTF-8" %>
<%
if(session.getAttribute("student_id")==null){response.sendRedirect("login.jsp");return;}String q=request.getParameter("id");String role=request.getParameter("role");if(q==null){response.sendRedirect("leaderboard.jsp");return;}int id=Integer.parseInt(q);Student s=new StudentDAO().getById(id);if(s==null){response.sendRedirect("leaderboard.jsp");return;}if(role==null)role=s.getRole();List<StudentWork> works=new WorkDAO().byStudent(id);List<Collaboration> cs=new CollaborationDAO().getCollaborationsByCreator(id);LikeDAO ld=new LikeDAO();boolean liked=ld.hasLiked((Integer)session.getAttribute("student_id"),id,role);int likes=ld.countReceived(id,role);RatingDAO rd=new RatingDAO();List<Rating> ratings=role.equalsIgnoreCase("CREATOR")?rd.forCreator(id):java.util.Collections.emptyList();double avg=rd.avg(id);
%>
<!DOCTYPE html><html><head><title><%=s.getName()%> · Creator Hub</title><link rel="stylesheet" href="style.css"></head><body>
<%@ include file="sidebar.jsp" %><nav class="nav"><a class="brand" href="dashboard.jsp">Creator Hub</a><div class="navlinks"><a href="leaderboard.jsp">Leaderboards</a><a href="logout.jsp" class="logout">Logout</a></div></nav>
<div class="container"><div class="hero"><div class="leader"><div class="avatar"><%=s.getName().substring(0,1).toUpperCase()%></div><div class="grow"><span class="pill"><%=role%></span><h1><%=s.getName()%></h1><p><%=s.getBio()==null?"":s.getBio()%></p></div><div><b><%=likes%> likes</b><%if(role.equalsIgnoreCase("CREATOR")){%><br><span class="rating">★ <%=String.format("%.1f",avg)%>/5</span><%}else{%><br><b><%=s.getCredits()%> credits</b><%}%></div></div>
<%Integer me=(Integer)session.getAttribute("student_id");if(me.equals(id)&&role.equalsIgnoreCase("CREATOR")){%><div class="actions"><a class="btn" href="creatorPortfolio.jsp">Manage my portfolio</a><a class="btn secondary" href="uploadWork.jsp">+ Add previous work</a></div><%}else if(!me.equals(id)){%><div class="actions"><a class="btn <%=liked?"green":"secondary"%>" href="likeProfile.jsp?target_id=<%=id%>&target_role=<%=role%>&back=profile.jsp%3Fid%3D<%=id%>%26role%3D<%=role%>"><%=liked?"Liked":"Like profile"%></a><%if(s.getLinkedinUrl()!=null&&!s.getLinkedinUrl().isEmpty()){%><a class="btn secondary" target="_blank" href="<%=s.getLinkedinUrl()%>">LinkedIn ↗</a><%}%></div><%}%>
</div>
<div class="grid topspace"><div class="card"><h2>About</h2><p><%=s.getBio()==null||s.getBio().isEmpty()?"No bio added yet.":s.getBio()%></p><h3>Skills</h3><p class="muted"><%=s.getSkills()==null||s.getSkills().isEmpty()?"Not listed":s.getSkills()%></p><%if(s.getLinkedinUrl()!=null&&!s.getLinkedinUrl().isEmpty()){%><a href="<%=s.getLinkedinUrl()%>" target="_blank" class="btn secondary">LinkedIn ↗</a><%}%></div>
<div class="card"><h2>Portfolio</h2><%if(works.isEmpty()){%><p class="muted">No portfolio work uploaded yet.</p><%}else for(StudentWork w:works){%><div class="work"><b><%=w.getFileName()%></b><br><a href="downloadWork.jsp?id=<%=w.getWorkId()%>" target="_blank">View previous work ↗</a></div><%}%></div></div>
<%if(role.equalsIgnoreCase("CREATOR")){%><div class="card topspace" id="opportunities"><h2>Creator opportunities</h2><%if(cs.isEmpty()){%><p class="muted">No collaborations posted.</p><%}else for(Collaboration c:cs){%><div class="work"><b><%=c.getTitle()%></b><span class="pill status"><%=c.getStatus()%></span><p class="muted"><%=c.getDescription()%></p></div><%}%></div>
<div class="card topspace" id="reputation"><h2>Student reviews</h2><%if(ratings.isEmpty()){%><p class="muted">No reviews yet.</p><%}else for(Rating r:ratings){%><div class="work"><span class="rating">★ <%=r.getRating()%>/5</span><p><%=r.getReview()%></p></div><%}%></div><%}%>
</div></body></html>