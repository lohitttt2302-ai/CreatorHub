<%@ page import="com.creatorhub.bean.Student" %><%@ page import="com.creatorhub.dao.StudentDAO" %><%@ page import="com.creatorhub.dao.LikeDAO" %><%@ page import="java.util.List" %><%@ page import="java.util.Map" %><%@ page contentType="text/html;charset=UTF-8" %>
<%
List<Student> students=new StudentDAO().leaderboard();List<Map<String,Object>> creators=new LikeDAO().creatorLeaderboard();Integer me=(Integer)session.getAttribute("student_id");
%>
<!DOCTYPE html><html><head><title>Leaderboards · Creator Hub</title><link rel="stylesheet" href="style.css"></head><body>
<%@ include file="sidebar.jsp" %><nav class="nav"><a class="brand" href="dashboard.jsp">Creator Hub</a><div class="navlinks"><a href="collaborations.jsp">Discover</a><%if(me!=null){%><a href="dashboard.jsp">My portal</a><%}%><a href="login.jsp">Login</a></div></nav>
<div class="container"><div class="hero"><span class="pill">COMMUNITY RANKINGS</span><h1>Who is making an impact?</h1><p>Reputation is built from completed collaborations, credits, likes and creator ratings.</p></div>
<div class="grid topspace"><div class="card"><h2>🏆 Student leaderboard</h2><p class="muted">Credits + profile likes + completed collaborations.</p><%int rank=1;for(Student s:students){int score=s.getCredits()+s.getLikesReceived()*5+s.getCompletedCount()*20;%><div class="work leader"><div class="rank">#<%=rank++%></div><div class="avatar"><%=s.getName().substring(0,1).toUpperCase()%></div><div class="grow"><a href="profile.jsp?id=<%=s.getStudentId()%>&role=STUDENT"><b><%=s.getName()%></b></a><div class="small muted">💎 <%=s.getCredits()%> · ❤️ <%=s.getLikesReceived()%> · 🤝 <%=s.getCompletedCount()%></div></div><div class="score"><%=score%></div></div><%}%></div>
<div class="card"><h2>⭐ Creator leaderboard</h2><p class="muted">Ratings + profile likes + completed collaborations.</p><%rank=1;for(Map<String,Object> m:creators){double rating=(Double)m.get("rating");int likes=(Integer)m.get("likes"),completed=(Integer)m.get("completed");int score=(int)Math.round(rating*20+likes*5+completed*20);%><div class="work leader"><div class="rank">#<%=rank++%></div><div class="avatar"><%=m.get("name").toString().substring(0,1).toUpperCase()%></div><div class="grow"><a href="profile.jsp?id=<%=m.get("id")%>&role=CREATOR"><b><%=m.get("name")%></b></a><div class="small muted">★ <%=String.format("%.1f",rating)%> · ❤️ <%=likes%> · 🤝 <%=completed%></div></div><div class="score"><%=score%></div></div><%}%></div></div></div></body></html>