<%@ page import="com.creatorhub.dao.StudentDAO" %><%@ page import="com.creatorhub.bean.Student" %><%@ page contentType="text/html;charset=UTF-8" %><%
Integer id=(Integer)session.getAttribute("student_id");if(id==null){response.sendRedirect("login.jsp");return;}Student s=new StudentDAO().getById(id);
%><!DOCTYPE html><html><head><title>Edit profile · Creator Hub</title><link rel="stylesheet" href="style.css"></head><body><div class="container"><div class="form-card card"><a class="brand" href="dashboard.jsp">Creator Hub</a><h1>Edit profile</h1><form action="updateProfile.jsp" method="post"><label>Name</label><input name="name" value="<%=s==null?"":s.getName()%>" required><label>Bio</label><textarea name="bio" rows="5" placeholder="Tell people what you create..."><%=s==null?"":s.getBio()%></textarea><label>Skills</label><input name="skills" value="<%=s==null?"":s.getSkills()%>" placeholder="Video editing, Photoshop, Java, photography..."><label>LinkedIn</label><input type="url" name="linkedin_url" value="<%=s==null?"":s.getLinkedinUrl()%>" placeholder="https://www.linkedin.com/in/..."><button class="btn full" type="submit">Save profile</button></form><div class="actions"><a class="btn secondary" href="studentPortal.jsp">Cancel</a></div></div></div></body></html>